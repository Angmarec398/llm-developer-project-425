# Параметры подключения к YDB Serverless (шаг 2 — "Подготовка окружения")
YDB_ENDPOINT=
YDB_DATABASE=

# Lockbox: ID секретов с параметрами YDB (не значения!) — шаг 3
YDB_ENDPOINT_SECRET_ID=
YDB_ENDPOINT_SECRET_VERSION_ID=
YDB_DATABASE_SECRET_ID=
YDB_DATABASE_SECRET_VERSION_ID=

# Lockbox: ID секрета с API-ключом AI Studio (опционально, для вызова моделей
# напрямую через SDK снаружи Yandex Cloud) — шаг 3
AI_STUDIO_API_KEY_SECRET_ID=
AI_STUDIO_API_KEY_SECRET_VERSION_ID=

# Имя ключа payload, под которым хранится значение внутри каждого секрета Lockbox
LOCKBOX_PAYLOAD_KEY=

# ID агента help-desk в Yandex AI Studio Agent Atelier — шаг 3
# (email-poller читает переменную, но операционно вызывает модель напрямую,
# не через агента, — см. README)
AI_STUDIO_AGENT_ID=

# IAM-токен для локальных скриптов (scripts/init_schema.py) — не секрет
# Lockbox, а короткоживущий токен: получать заново на каждую сессию
# (yc iam create-token) и не хранить в файле
YC_IAM_TOKEN=

# ID каталога Yandex Cloud — используется в gpt://<folder>/<model>/latest URI
# (Cloud Function email-poller и ydb-tickets)
YC_FOLDER_ID=

# Почтовый ящик Help Desk (IMAP + SMTP на одном хосте) — Cloud Function
# email-poller (шаг 4). Пароль — только в Lockbox (секрет email-credentials,
# ключ email_password), значения здесь нет.
IMAP_HOST=
SMTP_HOST=
IMAP_USER=
SMTP_USER=
IMAP_PASSWORD=
SMTP_PASSWORD=
HELPDESK_MAILBOX=
OPERATOR_EMAIL=

# Модель для email-poller (по умолчанию в коде — yandexgpt/latest; см. в
# README, каким значением она временно заменена и почему)
MODEL=

# MCP Hub gateway (шаг 5, инструмент ydb-tickets) и поисковый индекс RAG
# (шаг 7, file_search) — Cloud Function email-poller
MCP_GATEWAY_URL=
SEARCH_INDEX_ID=

# Сколько последних реплик истории диалога подмешивать в контекст агента
# (опционально, по умолчанию в коде — 10)
HISTORY_LIMIT=

# Модель-классификатор guardrail'а от prompt injection / off-topic (шаг 8,
# Cloud Function ydb-tickets; опционально, по умолчанию в коде —
# yandexgpt-lite/latest)
CLASSIFIER_MODEL=
