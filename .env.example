# Параметры подключения к YDB Serverless (шаг 2 — "Подготовка окружения")
YDB_ENDPOINT=
YDB_DATABASE=

# Lockbox: ID секретов с параметрами YDB (не значения!) — шаг 3
YDB_ENDPOINT_SECRET_ID=
YDB_ENDPOINT_SECRET_VERSION_ID=
YDB_DATABASE_SECRET_ID=
YDB_DATABASE_SECRET_VERSION_ID=

# Lockbox: ID секрета с API-ключом AI Studio (опционально, для вызова моделей
# напрямую через SDK снаружи Yandex Cloud) — шаг 3
AI_STUDIO_API_KEY_SECRET_ID=
AI_STUDIO_API_KEY_SECRET_VERSION_ID=

# Имя ключа payload, под которым хранится значение внутри каждого секрета Lockbox
LOCKBOX_PAYLOAD_KEY=

# ID агента help-desk в Yandex AI Studio Agent Atelier — шаг 3
AI_STUDIO_AGENT_ID=

# Почтовый workflow (email-poller) — шаг 4. Пароль приложения — только в Lockbox
# (секрет email-credentials, ключ password), здесь его нет.
MAIL=
MAIL_PASSWORD=
MAIL_SERVER=

